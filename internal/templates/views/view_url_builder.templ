package views

import (
	"fmt"
	"net/url"

	"github.com/damongolding/immich-kiosk/internal/common"
	"github.com/damongolding/immich-kiosk/internal/config"
	"github.com/damongolding/immich-kiosk/internal/i18n"
	"github.com/damongolding/immich-kiosk/internal/kiosk"
	"github.com/damongolding/immich-kiosk/internal/templates/partials"
	"github.com/damongolding/immich-kiosk/internal/weather"
	"golang.org/x/text/cases"
	"golang.org/x/text/language"
	"strconv"
	"strings"
	"slices"
)

type ChoicesOptions map[string]any

func weatherLocationOptions(locations []config.WeatherLocation) []string {
	var options []string

	if len(locations) > 1 {
		options = append(options, cases.Title(language.English).String(weather.WeatherRotation))
		options = append(options, weather.WeatherRotation)
	}

	for _, location := range locations {
		name := strings.TrimSpace(location.Name)
		if name == "" {
			continue
		}
		options = append(options, name, name)
	}
	return options
}

func boolPtrToStringPtr(b *bool) *string {
	if b == nil {
		return nil
	}
	if *b {
		s := "true"
		return &s
	} else {
		s := "false"
		return &s
	}
}

func intPtrToUInt64Ptr(i *int) *uint64 {
	if i == nil {
		return nil
	}
	u := uint64(*i)
	return &u
}

templ URLBuilder(viewData common.ViewData, urlData common.URLViewData, extended bool) {
	@HTMLTag(viewData.SystemLang) {
		<head>
			@partials.Head(viewData)
			<script src={ string(templ.URL(fmt.Sprintf("/assets/js/url-builder.%s.js", viewData.KioskVersion))) }></script>
		</head>
		<body id="url-builder" class="notranslate">
			<div class="url-container">
				@URLBuilderForm(viewData.Config, urlData, viewData.Queries, extended)
			</div>
		</body>
	}
}

templ URLBuilderForm(c config.Config, d common.URLViewData, queries url.Values, extended bool) {
	{{ var old common.URLBuilderRequest }}
	{{ if queries.Has("old_query") {
		var err error
		old, err = common.ParseURLBuilderRequest(queries.Get("old_query"))
		if err != nil {
			old = common.URLBuilderRequest{}
		}
		s := queries.Get("old_query")
		old.OldQuery = &s
	} }} 
	{{ if queries.Has("old_name") {
		s := queries.Get("old_name")
		old.Name = &s
	}}}
	{{ t := i18n.T() }}
	<section class={ "url-container--form", templ.KV("extended", extended) }>
		<div class="url-container--form--content">
			<div class="content">
				<h1>{ t("url_builder") }</h1>
				if !extended {
					<a href="/url-builder/extended" class="extended-link">{ t("extended_options") }</a>
				} else {
					<a href="/url-builder" class="extended-link">{ t("basic_options") }</a>
				}
				<form
					id="url-builder-form"
					hx-post="/url-builder/build"
					hx-trigger="load,change,multiselect-change from:body"
					hx-target="#url-result"
					hx-swap="outerHTML"
					if c.Kiosk.Password != "" {
						hx-headers={ templ.JSONString(map[string]string{
						"Authorization": fmt.Sprintf("Bearer %s", c.Kiosk.Password),
					}) }
					}
				>
					<h2>YAML Metadata</h2>
					if old.OldQuery != nil {
						<input type="hidden" name="old_query" value={ *old.OldQuery } />
					}
					if old.Name != nil {
						<input type="hidden" name="old_name" value={ *old.Name } />
					}
					@URLBuilderText("Name", "name", "The name of the redirect. Only required if you want to use the YAML output.", "", old.Name)
					@URLBuilderSelect("Type", "type", "The type of redirect to create.", old.Type,"internal", "internal", "external", "external")
					// Behaviour
					<h2>Behaviour</h2>
					@URLBuilderNumber("Duration", "duration", "The amount of time in seconds an asset will be displayed for", 0, 0, strconv.FormatInt(int64(c.Duration), 10),old.Duration)
					if extended {
						@URLBuilderRadio("Optimize", "optimize_images", "Scale images to fit the screen.", boolPtrToStringPtr(old.OptimizeImages), "true", "true", "false", "false")
						@URLBuilderNumber("Burn-in Interval", "burn_in_interval", "The interval between burn-in protection cycles (minutes, 0 to disable).", 0, 0, strconv.FormatInt(int64(c.BurnInInterval), 10), old.BurnInInterval)
						@URLBuilderNumber("Burn-in Duration", "burn_in_duration", "The duration of each burn-in protection cycle (seconds).", 1, 0, strconv.FormatInt(int64(c.BurnInDuration), 10), old.BurnInDuration)
						@URLBuilderNumber("Burn-in Opacity", "burn_in_opacity", "The opacity the UI will dip to, as a percentage", 0, 100, strconv.FormatInt(int64(c.BurnInOpacity), 10), old.BurnInOpacity)
					}
					// Buckets
					<h2>Buckets</h2>
					@URLBuilderMultiSelect("People", "people", "Person or people you want to display.") {
						for _, p := range d.People {
							<option value={ p.ID } selected?={slices.Contains(old.People, p.ID)}>{ p.Name }</option>
						}
					}
					@URLBuilderRadio("Require all people", "require_all_people", "Only show images where all selected people appear together.", boolPtrToStringPtr(old.RequireAllPeople), "true", "true", "false", "false")
					if extended {
						@URLBuilderMultiSelect("Excluded people", "excluded_people", "Person or people you want to exclude.") {
							for _, p := range d.People {
								<option value={ p.ID } selected?={slices.Contains(old.ExcludedPeople, p.ID)}>{ p.Name }</option>
							}
						}
					}
					@URLBuilderMultiSelect("Albums", "albums", "Album or albums you want to display. Albums with ~ special keyword albums") {
						for _, a := range d.Albums {
							<option value={ a.ID } selected?={slices.Contains(old.Albums, a.ID)}>{ a.AlbumName }</option>
						}
						// Special album keywords
						<option value="all">~ All Albums</option>
						<option value="owned">~ Owned Albums</option>
						<option value="shared">~ Shared Albums</option>
						<option value="favorites">~ Favorites</option>
					}
					if extended {
						@URLBuilderMultiSelect("Excluded albums", "excluded_albums", "Album or albums you want to exclude") {
							for _, a := range d.Albums {
								<option value={ a.ID } selected?={slices.Contains(old.ExcludedAlbums, a.ID)}>{ a.AlbumName }</option>
							}
						}
					}
					@URLBuilderRadio("Album order", "album_order", "The order in which albums will be displayed.", old.AlbumOrder, "random", "random", "newest", "newest", "oldest", "oldest")
					@URLBuilderMultiSelect("Tags", "tags", "Tag or tags you want to display") {
						for _, t := range d.Tags {
							if strings.EqualFold(t.Name, kiosk.TagSkip) || strings.EqualFold(t.Value, kiosk.TagSkip) {
								{{ continue }}
							}
							<option value={ t.ID } selected?={slices.Contains(old.Tags, t.ID)}>{ t.Name }</option>
						}
					}
					if extended {
						@URLBuilderMultiSelect("Excluded tags", "excluded_tags", "Tag or tags you want to exclude") {
							for _, t := range d.Tags {
								if strings.EqualFold(t.Name, kiosk.TagSkip) || strings.EqualFold(t.Value, kiosk.TagSkip) {
									{{ continue }}
								}
								<option value={ t.ID } selected?={slices.Contains(old.ExcludedTags, t.ID)}>{ t.Name }</option>
							}
						}
					}
					@URLBuilderNumber("Rating", "rating", "The star rating of assets you want to display", -1, 5, strconv.FormatInt(int64(c.Rating), 10), intPtrToUInt64Ptr(old.Rating))
					@URLBuilderRadio("Memories", "memories", "Display memories.", boolPtrToStringPtr(old.ShowMemories), "true", "true", "false", "false")
					if extended {
						@URLBuilderNumber("Past memory days", "past_memory_days", "Include memories from the last N days. 0 shows only today.", 0, 360, strconv.FormatInt(int64(c.PastMemoryDays), 10), old.PastMemoryDays)
						@URLBuilderRadio("Include archived", "show_archived", "Allow assets marked as archived to be displayed.", boolPtrToStringPtr(old.ShowArchived), "true", "true", "false", "false")
					}
					if extended {
						// Video
						<h2>Video</h2>
						@URLBuilderRadio("Show videos", "show_videos", "Display videos.", boolPtrToStringPtr(old.ShowVideos), "true", "true", "false", "false")
						@URLBuilderRadio("Live photos", "live_photos", "Display live photos.", boolPtrToStringPtr(old.LivePhotos), "true", "true", "false", "false")
						@URLBuilderNumber("Live photo loop delay", "live_photo_loop_delay", "The delay (in seconds) between each live photo replay.", 0, 0, strconv.FormatInt(int64(c.LivePhotoLoopDelay), 10), old.LivePhotoLoopDelay)
						@URLBuilderRadio("Show animated GIFs", "show_animated_gifs", "Display animated GIFs.", boolPtrToStringPtr(old.ShowAnimatedGifs), "true", "true", "false", "false")
					}
					// Clock
					<h2>Clock</h2>
					@URLBuilderRadio("Show time", "show_time", "Display the current time.", boolPtrToStringPtr(old.ShowTime), "true", "true", "false", "false")
					if extended {
						@URLBuilderRadio("Time format", "time_format", "The format in which the time will be displayed.", old.TimeFormat, "24", "12")
						@URLBuilderRadio("Show AM/PM", "show_am_pm", "Display AM/PM indicator for the time when the time format is 12 hour.", boolPtrToStringPtr(old.ShowAmPm), "true", "true", "false", "false")
					}
					@URLBuilderRadio("Show date", "show_date", "Display the current date.", boolPtrToStringPtr(old.ShowDate), "true", "true", "false", "false")
					if extended {
						@URLBuilderText("Date format", "date_format", "The format in which the date will be displayed.", c.DateFormat, old.DateFormat)
						@URLBuilderRadio("Clock source", "clock_source", "The source of the clock.", old.ClockSource, "Client", "client", "Server", "server")
					}
					// UI
					<h2>User Interface</h2>
					if extended {
						@URLBuilderRadio("Show clear cache button", "show_clear_cache_button", "Show a menu button to clear the Kiosk server cache.", boolPtrToStringPtr(old.ShowClearCacheButton), "true", "true", "false", "false")
					}
					@URLBuilderRadio("Show progress bar", "show_progress_bar", "Show a progress bar indicating the time remaining for the current asset.", boolPtrToStringPtr(old.ShowProgressBar), "true", "true", "false", "false")
					if extended {
						@URLBuilderRadio("Progress bar position", "progress_bar_position", "Set the position of the progress bar.", old.ProgressBarPosition, "top", "top", "bottom", "bottom")
						@URLBuilderRadio("Hide cursor", "hide_cursor", "", boolPtrToStringPtr(old.HideCursor), "true", "true", "false", "false")
						@URLBuilderNumber("Font size", "font_size", "The base font size for Kiosk. Default is 100% (16px).", 100, 0, strconv.FormatInt(int64(c.FontSize), 10), old.FontSize)
					}
					@URLBuilderSelect("Theme", "theme", "Theme to use for the UI", old.Theme, "fade", "fade", "solid", "solid", "bubble", "bubble")
					@URLBuilderSelect("Layout", "layout", "How images are arranged on the screen", old.Layout, "single", "single", "portrait", "portrait", "landscape", "landscape", "splitview", "splitview", "splitview-landscape", "splitview-landscape")
					<h2>Transitions</h2>
					// Transition
					@URLBuilderSelect("Transition", "transition", "Transition to use when changing images", old.Transition, "none", "none", "fade", "fade", "cross-fade", "cross-fade")
					if extended {
						// Image Display Options
						<h2>Image Display Options</h2>
						@URLBuilderRadio("Image fit", "image_fit", "How the image will fit on your screen.", old.ImageFit, "none", "none", "contain", "contain", "cover", "cover")
						@URLBuilderRadio("Image effect", "image_effect", "Add an effect to images.", old.ImageEffect, "none", "none", "zoom", "zoom", "smart-zoom", "smart-zoom")
						@URLBuilderNumber("Image effect amount", "image_effect_amount", "Set the intensity of the image effect.", 100, 0, strconv.FormatInt(int64(c.ImageEffectAmount), 10), old.ImageEffectAmount)
						@URLBuilderRadio("Use original image", "use_original_image", "Use the original image instead of the Immich optimized version.", boolPtrToStringPtr(old.UseOriginalImage), "true", "true", "false", "false")
						// Metadata
						<h2>Metadata</h2>
						@URLBuilderRadio("Show star rating", "show_image_rating", "Show the star rating of the asset.", boolPtrToStringPtr(old.ShowImageRating), "true", "true", "false", "false")
						@URLBuilderRadio("Show owner", "show_owner", "Show the owner of the asset.", boolPtrToStringPtr(old.ShowOwner), "true", "true", "false", "false")
						@URLBuilderRadio("Show album name", "show_album_name", "Display album name(s) that the asset appears in.", boolPtrToStringPtr(old.ShowAlbumName), "true", "true", "false", "false")
						@URLBuilderRadio("Show person name", "show_person_name", "Display person name(s).", boolPtrToStringPtr(old.ShowPersonName), "true", "true", "false", "false")
						@URLBuilderRadio("Show person age", "show_person_age", "Display person age.", boolPtrToStringPtr(old.ShowPersonAge), "true", "true", "false", "false")
						@URLBuilderRadio("Show image time", "show_image_time", "Show the time the image was taken.", boolPtrToStringPtr(old.ShowImageTime), "true", "true", "false", "false")
						@URLBuilderRadio("Image time format", "image_time_format", "Format for displaying image time.", old.ImageTimeFormat, "24 hour", "24", "12 hour", "12")
						@URLBuilderText("Image date format", "image_date_format", "Format for displaying image date.", "YYYY-MM-DD", old.ImageDateFormat)
						@URLBuilderRadio("Show image description", "show_image_description", "Show the description of the image.", boolPtrToStringPtr(old.ShowImageDescription), "true", "true", "false", "false")
						@URLBuilderRadio("Show image camera", "show_image_camera", "Show camera model for the image.", boolPtrToStringPtr(old.ShowImageCamera), "true", "true", "false", "false")
						@URLBuilderRadio("Show image EXIF", "show_image_exif", "Show EXIF metadata for the image.", boolPtrToStringPtr(old.ShowImageEXIF), "true", "true", "false", "false")
						@URLBuilderRadio("Show image location", "show_image_location", "Show the location where the image was taken.", boolPtrToStringPtr(old.ShowImageLocation), "true", "true", "false", "false")
						<div class="form-group">
							<label>Image Location</label>
							<div class="form-group--description">
								These options only apply when “Show image location” is enabled.
							</div>
							<div style="padding-left: 1rem; display: flex; flex-direction: column; gap: 1.5rem">
								@URLBuilderRadio("Hide city", "image_location_hide_city", "Hide the city name in the location.", boolPtrToStringPtr(old.ImageLocationHideCity), "true", "true", "false", "false")
								@URLBuilderRadio("Hide state", "image_location_hide_state", "Hide the state name in the location.", boolPtrToStringPtr(old.ImageLocationHideState), "true", "true", "false", "false")
								@URLBuilderRadio("Hide country", "image_location_hide_country", "Hide the country name in the location.", boolPtrToStringPtr(old.ImageLocationHideCountry), "true", "true", "false", "false")
							</div>
						</div>
						@URLBuilderRadio("Show image QR", "show_image_qr", "Display a QR code linking to the original image (in Immich).", boolPtrToStringPtr(old.ShowImageQR), "true", "true", "false", "false")
						@URLBuilderRadio("Show image ID", "show_image_id", "Display the Immich ID of the image.", boolPtrToStringPtr(old.ShowImageID), "true", "true", "false", "false")
						if extended {
							// Weather
							<h2>Weather</h2>
							if len(c.Weather.Locations) > 0 {
								@URLBuilderSelect("Weather location", weather.WeatherParam, "The configured weather location name, or rotate to cycle through configured locations.", old.Weather, weatherLocationOptions(c.Weather.Locations)...)
								@URLBuilderNumber("Weather rotation interval", weather.WeatherRotationIntervalParam, "The interval in seconds to rotate weather locations.", 10, 0, strconv.FormatInt(int64(c.Weather.RotationInterval), 10), old.WeatherRotationInterval)
								@URLBuilderRadio("Show forecast", weather.WeatherShowForecastParam, "Display the weather forecast when forecast data is configured for the selected location at startup.", boolPtrToStringPtr(old.WeatherShowForecast), "true", "true", "false", "false")
								@URLBuilderRadio("Show humidity", weather.WeatherShowHumidityParam, "Display the humidity stat.", boolPtrToStringPtr(old.WeatherShowHumidity), "true", "true", "false", "false")
								@URLBuilderRadio("Show wind", weather.WeatherShowWindParam, "Display the wind stat.", boolPtrToStringPtr(old.WeatherShowWind), "true", "true", "false", "false")
								@URLBuilderRadio("Show wind direction", weather.WeatherShowWindDirectionParam, "Display degrees for wind direction.", boolPtrToStringPtr(old.WeatherShowWindDirection), "true", "true", "false", "false")
								@URLBuilderRadio("Show visibility", weather.WeatherShowVisibilityParam, "Display the visibility stat.", boolPtrToStringPtr(old.WeatherShowVisibility), "true", "true", "false", "false")
								@URLBuilderRadio("Show temperature range", weather.WeatherShowTemperatureRangeParam, "Display the next 24 hour high and low when forecast data is configured for the selected location at startup.", boolPtrToStringPtr(old.WeatherShowTemperatureRange), "true", "true", "false", "false")
								@URLBuilderRadio("Round temperature", weather.WeatherRoundTemperatureParam, "Round displayed temperatures to whole numbers.", boolPtrToStringPtr(old.WeatherRoundTemperature), "true", "true", "false", "false")
							} else {
								<div class="form-group">
									<span>No weather locations configured.</span>
								</div>
							}
						}
						// More information
						<h2>More Information Overlay</h2>
						@URLBuilderRadio("Show more info", "show_more_info", "Enable the more information overlay.", boolPtrToStringPtr(old.ShowMoreInfo), "true", "true", "false", "false")
						@URLBuilderRadio("Show more info image link", "show_more_info_image_link", "Display a link to the image in the more info overlay.", boolPtrToStringPtr(old.ShowMoreInfoImageLink), "true", "true", "false", "false")
						@URLBuilderRadio("Show more info QR code", "show_more_info_qr_code", "Display a QR code in the more info overlay.", boolPtrToStringPtr(old.ShowMoreInfoQRCode), "true", "true", "false", "false")
						@URLBuilderMultiSelect("Like button action", "like_button_action", "Action(s) to perform when the like button is clicked.") {
							<option value="favorite" selected?={slices.Contains(old.LikeButtonAction, "favorite")}>Favorite</option>
							<option value="album" selected?={slices.Contains(old.LikeButtonAction, "album")}>Album</option>
						}
						@URLBuilderMultiSelect("Hide button action", "hide_button_action", "Action(s) to perform when the hide button is clicked.") {
							<option value="tag" selected?={slices.Contains(old.HideButtonAction, "tag")}>Tag</option>
							<option value="archive" selected?={slices.Contains(old.HideButtonAction, "archive")}>Archive</option>
						}
					}
				</form>
			</div>
			<div class="result--container">
				<div class="result form-group">
					<div id="url-result"></div>
					<button class="copy">
						<svg width="16" height="18" viewBox="0 0 16 18" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M6.85714 0C5.59643 0 4.57143 1.00898 4.57143 2.25V11.25C4.57143 12.491 5.59643 13.5 6.85714 13.5H13.7143C14.975 13.5 16 12.491 16 11.25V4.19766C16 3.58594 15.7464 2.99883 15.2964 2.57344L13.2357 0.625781C12.8107 0.225 12.2429 0 11.6536 0H6.85714ZM2.28571 4.5C1.025 4.5 0 5.50898 0 6.75V15.75C0 16.991 1.025 18 2.28571 18H9.14286C10.4036 18 11.4286 16.991 11.4286 15.75V15.1875H9.14286V15.75H2.28571V6.75H2.85714V4.5H2.28571Z"></path>
						</svg>
					</button>

					<div class="field">
						<label>YAML Output</label>
						<pre id="yaml-result" class="yaml-display"><code>name: example
		version: 1.0.0
		description: A long config line to demonstrate horizontal scrolling when overflow occurs</code></pre>
					</div>

					<button 
						type="button" 
						class="extended-link"
						hx-post="/url-builder/build"
						hx-include="#url-builder-form"
						hx-vals='{"save": "true"}'
						hx-target="#url-result"
						hx-swap="outerHTML"
					>
						Save
					</button>
				</div>
			</div>
		</div>
	</section>
}

templ URLBuilderNumber(displayName, formName, helpText string, min int, max int, placeholder string, oldValue *uint64) {
	<div class="form-group">
		<label for={ "url-builder-" + formName }>{ displayName }</label>
		@URLBuilderHelpText(helpText)
		<input
			type="number"
			id={ "url-builder-" + formName }
			name={ formName }
			min={ min }
			if max != 0 {
				max={ max }
			}
			placeholder={ placeholder }
			if oldValue != nil {
				value={ *oldValue }
			}
		/>
	</div>
}

templ URLBuilderHelpText(text string) {
	{{ text = strings.TrimSpace(text) }}
	<div class="form-group--description">
		if text != "" && !strings.HasSuffix(text, ".") {
			{ text }.
		} else {
			{ text }
		}
	</div>
}

templ URLBuilderMultiSelectBase(elementID, displayName, formName, helpText string) {
	<div class="form-group">
		<label for={ elementID }>{ displayName }</label>
		@URLBuilderHelpText(helpText)
		<select
			name={ formName }
			id={ elementID }
			multiple
		>
			{ children... }
		</select>
	</div>
}

templ URLBuilderMultiSelect(displayName, formName, helpText string) {
	{{ elementID := "url-builder-" + formName }}
	@URLBuilderMultiSelectBase(elementID, displayName, formName, helpText) {
		{ children... }
	}
	@templ.JSFuncCall("urlBuilder.initMultiselect", elementID, displayName)
}

templ URLBuilderMultiSelectWithOptions(displayName, formName, helpText string, options ChoicesOptions) {
	{{ elementID := "url-builder-" + formName }}
	@URLBuilderMultiSelectBase(elementID, displayName, formName, helpText) {
		{ children... }
	}
	@templ.JSFuncCall("urlBuilder.initMultiselect", elementID, displayName, options)
}

templ URLBuilderRadio(displayName string, formName string, helpText string, oldValue *string, keyvals ...string) {
	<div class="form-group">
		<legend>{ displayName }</legend>
		@URLBuilderHelpText(helpText)
		{{
			kvs := make([]string, 0, len(keyvals)+2)
			kvs = append(kvs, "default", "")
			kvs = append(kvs, keyvals...)
			if len(kvs) % 2 != 0 {
				panic(fmt.Sprintf("keyvals for '%s' must have an even number of elements", formName))
			}
		}}
		<div class="form-group--radio-group">
			for i:=0; i<len(kvs); i+=2 {
				<div class="form-group--radio">
					<input
						type="radio"
						id={ formName + "_" + kvs[i+1] }
						name={ formName }
						value={ kvs[i+1] }
						if (oldValue == nil && i==0) || (oldValue != nil && *oldValue == kvs[i+1]) {
							checked="checked"
						}
					/>
					<label for={ formName + "_" + kvs[i+1] }>{ cases.Title(language.English).String(kvs[i]) }</label>
				</div>
			}
		</div>
	</div>
}

templ URLBuilderText(displayName, formName, helpText, defaultValue string, oldValue *string) {
	<div class="form-group">
		{{ elementID := "url-builder-" + formName }}
		<label for={ elementID }>{ displayName }</label>
		@URLBuilderHelpText(helpText)
		<input
			type="text"
			id={ elementID }
			name={ formName }
			placeholder={ defaultValue }
			if oldValue != nil {
				value={ *oldValue }
			} else {
				value=""
			}
		/>
	</div>
}

templ URLBuilderSelect(displayName string, formName string, helpText string, oldValue *string, keyvals ...string) {
	<div class="form-group">
		{{ elementID := "url-builder-" + formName }}
		<label for={ elementID }>{ displayName }</label>
		@URLBuilderHelpText(helpText)
		{{
			kvs := make([]string, 0, len(keyvals)+2)
			kvs = append(kvs, "default", "")
			kvs = append(kvs, keyvals...)
			if len(kvs) % 2 != 0 {
				panic(fmt.Sprintf("keyvals for '%s' must have an even number of elements", formName))
			}
		}}
		<select id={ elementID } name={ formName }>
			for i:=0; i<len(kvs); i+=2 {
				<option
					value={ kvs[i+1] }
					if (oldValue == nil && i==0) || (oldValue != nil && *oldValue == kvs[i+1]) {
						selected="selected"
					}
				>{ kvs[i] }</option>
			}
		</select>
	</div>
}
